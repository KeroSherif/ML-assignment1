    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "rating=pd.read_csv(\"Data/ratings.csv\")\n",
    "movie=pd.read_csv(\"Data/movies.csv\")\n",
    "print(rating)\n",
    "print(movie)\n"
   ]
  },
