   "source": [
    "#database statistics\n",
    "nusers=rating.userId.nunique()\n",
    "nmovies=rating.movieId.nunique()  # only movies that have at least one rating\n",
    "nrating=len(rating.rating)\n",
    "Sparsity=(1-(nrating/(nusers*nmovies)))*100\n",
    "print(nusers,nmovies,nrating,Sparsity)"
   ]
  },
